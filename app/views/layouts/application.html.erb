<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Schedule A — Tax Deduction Tracker</title>
  <link rel="stylesheet" href="https://unpkg.com/lucide-static@latest/font/lucide.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            warm: {
              50:  '#fdf8f0', 100: '#faecd8', 200: '#f5d5a8', 300: '#e8b86d',
              400: '#d4943a', 500: '#c47a1e', 600: '#a86316', 700: '#8a4e13',
              800: '#6b3c11', 900: '#4a2a0e',
            }
          }
        }
      }
    }
  </script>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", media: "all" %>
</head>
<body class="bg-warm-50 text-gray-800 min-h-screen flex flex-col font-sans antialiased">
  <% if logged_in? %>
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 bg-warm-800 text-white shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center h-14">
        <a href="<%= web_dashboard_path %>" class="flex items-center gap-2 text-warm-200 hover:text-white font-bold text-lg mr-8 no-underline">
          <i class="lucide-receipt text-warm-300 text-xl"></i> Schedule A
        </a>
        <div class="flex items-center gap-1 flex-1 overflow-x-auto">
          <a href="<%= web_dashboard_path %>" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-warm-200 hover:bg-warm-700 hover:text-white text-sm font-medium no-underline transition-colors">
            <i class="lucide-layout-dashboard text-sm"></i> Dashboard
          </a>
          <a href="<%= web_receipts_path %>" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-warm-200 hover:bg-warm-700 hover:text-white text-sm font-medium no-underline transition-colors">
            <i class="lucide-file-text text-sm"></i> Receipts
          </a>
          <a href="<%= web_summaries_path %>" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-warm-200 hover:bg-warm-700 hover:text-white text-sm font-medium no-underline transition-colors">
            <i class="lucide-bar-chart-3 text-sm"></i> Summaries
          </a>
          <a href="<%= web_exports_path %>" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-warm-200 hover:bg-warm-700 hover:text-white text-sm font-medium no-underline transition-colors">
            <i class="lucide-download text-sm"></i> Export
          </a>
          <a href="<%= web_settings_path %>" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-warm-200 hover:bg-warm-700 hover:text-white text-sm font-medium no-underline transition-colors">
            <i class="lucide-settings text-sm"></i> Settings
          </a>
        </div>
        <div class="flex items-center gap-4 ml-auto">
          <span class="text-warm-200 text-sm flex items-center gap-1.5"><i class="lucide-user text-sm"></i> <%= current_user.full_name %></span>
          <%= button_to logout_path, method: :delete, class: "flex items-center gap-1.5 text-warm-300 hover:text-red-400 text-sm font-medium bg-transparent border-0 cursor-pointer transition-colors" do %>
            <i class="lucide-log-out text-sm"></i> Log out
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-7">
      <% if flash[:notice] %>
        <div class="flex items-center gap-2.5 bg-green-50 text-green-800 text-sm font-medium px-4 py-3 rounded-lg mb-5">
          <i class="lucide-check-circle"></i> <%= flash[:notice] %>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="flex items-center gap-2.5 bg-red-50 text-red-800 text-sm font-medium px-4 py-3 rounded-lg mb-5">
          <i class="lucide-alert-circle"></i> <%= flash[:alert] %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="text-center py-5 text-gray-400 text-sm border-t border-gray-200 mt-auto">
      <p>Schedule A &mdash; Tax Deduction Tracker &copy; <%= Date.current.year %></p>
    </footer>
  <% else %>
    <!-- Auth Layout -->
    <main class="flex-1 flex flex-col items-center justify-center px-4 py-12">
      <div class="w-full max-w-[420px]">
        <% if flash[:notice] %>
          <div class="flex items-center gap-2 bg-green-50 text-green-800 text-sm font-medium px-4 py-3 rounded-lg mb-4">
            <i class="lucide-check-circle"></i> <%= flash[:notice] %>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="flex items-center gap-2 bg-red-50 text-red-800 text-sm font-medium px-4 py-3 rounded-lg mb-4">
            <i class="lucide-alert-circle"></i> <%= flash[:alert] %>
          </div>
        <% end %>
        <%= yield %>
      </div>
    </main>
  <% end %>
</body>
</html>
