<!-- Page Header -->
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-warm-900 flex items-center gap-2.5">
    <i class="lucide-settings text-warm-500 text-[26px]"></i> Settings
  </h1>
</div>

<!-- Business Profiles -->
<div class="bg-white rounded-lg shadow-sm p-6 mb-5">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
      <i class="lucide-briefcase text-warm-500"></i> Business Profiles
    </h2>
    <a href="<%= new_web_business_profile_path %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-warm-600 hover:bg-warm-700 text-white text-sm font-medium rounded-lg shadow-sm no-underline transition-colors">
      <i class="lucide-plus text-sm"></i> Add Profile
    </a>
  </div>

  <% if @profiles.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Business Name</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">EIN</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Type</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Tax Year</th>
            <th class="px-3 py-2.5 bg-warm-100 border-b-2 border-warm-200"></th>
          </tr>
        </thead>
        <tbody>
          <% @profiles.each do |profile| %>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-3 py-2.5 border-b border-gray-200"><%= profile.business_name %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= profile.ein || "—" %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= profile.business_type.titleize %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= profile.tax_year %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 whitespace-nowrap">
                <a href="<%= edit_web_business_profile_path(profile) %>" class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium rounded border border-gray-300 no-underline transition-colors">
                  <i class="lucide-edit text-xs"></i>
                </a>
                <%= button_to web_business_profile_path(profile), method: :delete, class: "inline-flex items-center gap-1 px-2 py-1 bg-red-500 hover:bg-red-700 text-white text-xs font-medium rounded border-0 cursor-pointer transition-colors", data: { turbo_confirm: "Delete this business profile?" } do %>
                  <i class="lucide-trash-2 text-xs"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-400">
      <i class="lucide-briefcase text-5xl text-warm-300 block mb-3"></i>
      <p class="text-base mb-4">No business profiles yet.</p>
      <a href="<%= new_web_business_profile_path %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-warm-600 hover:bg-warm-700 text-white text-sm font-medium rounded-lg shadow-sm no-underline transition-colors">
        <i class="lucide-plus text-sm"></i> Add Profile
      </a>
    </div>
  <% end %>
</div>

<!-- Accounts -->
<div class="bg-white rounded-lg shadow-sm p-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
      <i class="lucide-credit-card text-warm-500"></i> Payment Accounts
    </h2>
    <a href="<%= new_web_account_path %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-warm-600 hover:bg-warm-700 text-white text-sm font-medium rounded-lg shadow-sm no-underline transition-colors">
      <i class="lucide-plus text-sm"></i> Add Account
    </a>
  </div>

  <% if @accounts.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Nickname</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Last 4</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Type</th>
            <th class="px-3 py-2.5 bg-warm-100 border-b-2 border-warm-200"></th>
          </tr>
        </thead>
        <tbody>
          <% @accounts.each do |acct| %>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-3 py-2.5 border-b border-gray-200"><%= acct.nickname %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= acct.last4 %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= acct.account_type.titleize %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 whitespace-nowrap">
                <a href="<%= edit_web_account_path(acct) %>" class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium rounded border border-gray-300 no-underline transition-colors">
                  <i class="lucide-edit text-xs"></i>
                </a>
                <%= button_to web_account_path(acct), method: :delete, class: "inline-flex items-center gap-1 px-2 py-1 bg-red-500 hover:bg-red-700 text-white text-xs font-medium rounded border-0 cursor-pointer transition-colors", data: { turbo_confirm: "Remove this account?" } do %>
                  <i class="lucide-trash-2 text-xs"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-400">
      <i class="lucide-credit-card text-5xl text-warm-300 block mb-3"></i>
      <p class="text-base mb-4">No accounts yet.</p>
      <a href="<%= new_web_account_path %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-warm-600 hover:bg-warm-700 text-white text-sm font-medium rounded-lg shadow-sm no-underline transition-colors">
        <i class="lucide-plus text-sm"></i> Add Account
      </a>
    </div>
  <% end %>
</div>
