<div class="page-header">
  <h1 class="page-title"><i class="lucide-edit"></i> Edit Receipt #<%= @receipt.receipt_number %></h1>
</div>

<div class="card">
  <%= form_with model: @receipt, url: web_receipt_path(@receipt), method: :patch, local: true do |f| %>
    <%= render "form", f: f, receipt: @receipt %>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><i class="lucide-save"></i> Save Changes</button>
      <a href="<%= web_receipt_path(@receipt) %>" class="btn btn-secondary"><i class="lucide-x"></i> Cancel</a>
    </div>
  <% end %>
</div>
