<!-- Page Header -->
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-warm-900 flex items-center gap-2.5">
    <i class="lucide-file-text text-warm-500 text-[26px]"></i> Receipt #<%= @receipt.receipt_number %>
  </h1>
  <div class="flex items-center gap-2">
    <% if @receipt.status != "confirmed" %>
      <%= button_to confirm_web_receipt_path(@receipt), method: :post, class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-500 hover:bg-green-700 text-white text-sm font-medium rounded-lg border-0 cursor-pointer transition-colors" do %>
        <i class="lucide-check-circle text-sm"></i> Confirm
      <% end %>
    <% end %>
    <a href="<%= edit_web_receipt_path(@receipt) %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg border border-gray-300 no-underline transition-colors">
      <i class="lucide-edit text-sm"></i> Edit
    </a>
    <%= button_to web_receipt_path(@receipt), method: :delete, class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-red-500 hover:bg-red-700 text-white text-sm font-medium rounded-lg border-0 cursor-pointer transition-colors", data: { turbo_confirm: "Delete this receipt and all its expense lines?" } do %>
      <i class="lucide-trash-2 text-sm"></i> Delete
    <% end %>
  </div>
</div>

<% if @receipt.status == "extracted" && @receipt.raw_ocr_text.blank? %>
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg px-4 py-3 mb-5 text-sm text-yellow-800 flex items-start gap-2">
    <i class="lucide-alert-triangle text-yellow-500 mt-0.5"></i>
    <div>
      <strong>OCR could not read this receipt.</strong> The image may be blurry, too dark, or in an unsupported format.
      <a href="<%= edit_web_receipt_path(@receipt) %>" class="underline font-medium">Fill in the details manually.</a>
    </div>
  </div>
<% elsif @receipt.status == "extracted" && @receipt.store_name.blank? && @receipt.total_amount.blank? %>
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg px-4 py-3 mb-5 text-sm text-yellow-800 flex items-start gap-2">
    <i class="lucide-alert-triangle text-yellow-500 mt-0.5"></i>
    <div>
      <strong>OCR detected text but could not extract receipt details.</strong> The receipt format may not be recognized.
      <a href="<%= edit_web_receipt_path(@receipt) %>" class="underline font-medium">Fill in the details manually.</a>
    </div>
  </div>
<% end %>

<!-- Receipt Details -->
<div class="bg-white rounded-lg shadow-sm p-6 mb-5">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-5">
    <div>
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Store</div>
      <div class="text-sm text-gray-800 font-medium mt-0.5"><%= @receipt.store_name || "—" %></div>
    </div>
    <div>
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Date</div>
      <div class="text-sm text-gray-800 font-medium mt-0.5"><%= @receipt.transaction_date&.strftime("%B %d, %Y") || "—" %></div>
    </div>
    <div>
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Time</div>
      <div class="text-sm text-gray-800 font-medium mt-0.5"><%= @receipt.transaction_time || "—" %></div>
    </div>
    <div>
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Total</div>
      <div class="text-sm text-gray-800 font-medium mt-0.5"><%= format_currency(@receipt.total_amount) %></div>
    </div>
    <div>
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Location</div>
      <div class="text-sm text-gray-800 font-medium mt-0.5"><%= [@receipt.city, @receipt.state].compact.join(", ").presence || "—" %></div>
    </div>
    <div>
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Account</div>
      <div class="text-sm text-gray-800 font-medium mt-0.5"><%= @receipt.account ? "#{@receipt.account.nickname} (••••#{@receipt.account.last4})" : "—" %></div>
    </div>
    <div>
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Status</div>
      <div class="mt-1"><%= status_badge(@receipt.status) %></div>
    </div>
    <div>
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Type</div>
      <div class="mt-1"><%= designation_badge(@receipt.designation) %></div>
    </div>
  </div>

  <% if @receipt.image.attached? %>
    <div class="mt-3 pt-4 border-t border-gray-200">
      <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide mb-2">Receipt Image</div>
      <% if @receipt.image.content_type.start_with?("image/") %>
        <%= image_tag rails_blob_path(@receipt.image, only_path: true), class: "max-w-sm rounded-lg border border-gray-200" %>
      <% else %>
        <a href="<%= rails_blob_path(@receipt.image, only_path: true) %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg border border-gray-300 no-underline transition-colors" target="_blank">
          <i class="lucide-file text-sm"></i> View PDF
        </a>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Expense Lines -->
<div class="bg-white rounded-lg shadow-sm p-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
      <i class="lucide-list text-warm-500"></i> Expense Lines
    </h2>
  </div>

  <% if @expense_lines.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">ID</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Item</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Cost</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Category</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Write-off %</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Write-off $</th>
            <th class="px-3 py-2.5 bg-warm-100 border-b-2 border-warm-200"></th>
          </tr>
        </thead>
        <tbody>
          <% @expense_lines.each do |line| %>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-3 py-2.5 border-b border-gray-200"><%= line.transaction_display_id %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= line.item %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= format_currency(line.cost) %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= category_label(line.tax_category) %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= line.writeoff_percent %>%</td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= format_currency(line.writeoff_value) %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 whitespace-nowrap flex items-center gap-1">
                <a href="<%= edit_web_receipt_expense_line_path(@receipt, line) %>" class="inline-flex items-center gap-1 px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium rounded border border-gray-300 no-underline transition-colors">
                  <i class="lucide-edit text-xs"></i>
                </a>
                <%= button_to web_receipt_expense_line_path(@receipt, line), method: :delete, class: "inline-flex items-center gap-1 px-2 py-1 bg-red-500 hover:bg-red-700 text-white text-xs font-medium rounded border-0 cursor-pointer transition-colors", data: { turbo_confirm: "Remove this expense line?" } do %>
                  <i class="lucide-trash-2 text-xs"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-400 py-3">No expense lines yet. Add one below.</p>
  <% end %>

  <!-- Add Expense Line Form -->
  <div class="mt-5 pt-4 border-t border-gray-200">
    <h3 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-1.5">
      <i class="lucide-plus-circle text-warm-500 text-base"></i> Add Expense Line
    </h3>
    <%= form_with model: @new_expense_line, url: web_receipt_expense_lines_path(@receipt), method: :post, local: true do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Item</label>
          <%= f.text_field :item, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-800 bg-white focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20 transition", placeholder: "e.g. Printer Paper", required: true %>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Cost</label>
          <%= f.number_field :cost, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-800 bg-white focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20 transition", step: "0.01", min: "0", placeholder: "0.00", required: true %>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Tax Category</label>
          <%= f.select :tax_category, ExpenseLine::SCHEDULE_C_CATEGORIES.keys.map { |k| [k.titleize, k] }, { include_blank: "— Select —" }, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-800 bg-white focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20 transition" %>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Write-off %</label>
          <%= f.number_field :writeoff_percent, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-800 bg-white focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20 transition", value: 100, min: 0, max: 100, step: "0.01" %>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 bg-warm-600 hover:bg-warm-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors">
          <i class="lucide-plus text-sm"></i> Add Line
        </button>
      </div>
    <% end %>
  </div>
</div>

<% if @receipt.raw_ocr_text.present? %>
  <details class="bg-white rounded-lg shadow-sm p-6 mt-5">
    <summary class="text-sm font-semibold text-gray-700 cursor-pointer flex items-center gap-1.5">
      <i class="lucide-scan-text text-warm-500"></i> Raw OCR Text
    </summary>
    <pre class="mt-3 p-4 bg-gray-50 rounded-lg text-xs text-gray-600 whitespace-pre-wrap overflow-x-auto border border-gray-200"><%= @receipt.raw_ocr_text %></pre>
  </details>
<% end %>
