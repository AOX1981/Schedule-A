<!-- Page Header -->
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-warm-900 flex items-center gap-2.5">
    <i class="lucide-upload text-warm-500 text-[26px]"></i> Upload Receipt
  </h1>
</div>

<div class="bg-white rounded-lg shadow-sm p-6">
  <%= form_with model: @receipt, url: web_receipts_path, method: :post, local: true, multipart: true do |f| %>
    <div class="mb-4">
      <label class="block text-sm font-semibold text-gray-700 mb-1">
        <i class="lucide-image text-sm"></i> Receipt Image / PDF
      </label>
      <%= f.file_field :image, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-800 bg-white focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20 transition", accept: "image/*,application/pdf" %>
      <p class="text-xs text-gray-500 mt-1">Upload a photo or PDF of your receipt. OCR will attempt to extract details automatically.</p>
    </div>

    <%= render "form", f: f, receipt: @receipt %>

    <div class="flex items-center gap-2.5 mt-5">
      <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-warm-600 hover:bg-warm-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors">
        <i class="lucide-upload text-sm"></i> Upload Receipt
      </button>
      <a href="<%= web_receipts_path %>" class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg border border-gray-300 no-underline transition-colors">
        <i class="lucide-x text-sm"></i> Cancel
      </a>
    </div>
  <% end %>
</div>
