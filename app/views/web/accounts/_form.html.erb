<% if account.errors.any? %>
  <div class="bg-red-50 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">
    <strong>Please fix the following:</strong>
    <ul class="mt-1 ml-5 list-disc">
      <% account.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: account, url: url, method: account.persisted? ? :patch : :post, local: true do |f| %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1"><i class="lucide-tag text-sm"></i> Nickname</label>
      <%= f.text_field :nickname, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-800 bg-white focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20 transition", placeholder: "e.g. Chase Sapphire", required: true %>
    </div>
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1"><i class="lucide-hash text-sm"></i> Last 4 Digits</label>
      <%= f.text_field :last4, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-800 bg-white focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20 transition", placeholder: "4242", maxlength: 4, required: true %>
    </div>
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1"><i class="lucide-credit-card text-sm"></i> Account Type</label>
      <%= f.select :account_type, Account::ACCOUNT_TYPES.map { |t| [t.titleize, t] }, {}, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-800 bg-white focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20 transition" %>
    </div>
  </div>
  <div class="flex items-center gap-2.5 mt-5">
    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-warm-600 hover:bg-warm-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors">
      <i class="lucide-save text-sm"></i> Save
    </button>
    <a href="<%= web_settings_path %>" class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg border border-gray-300 no-underline transition-colors">
      <i class="lucide-x text-sm"></i> Cancel
    </a>
  </div>
<% end %>
