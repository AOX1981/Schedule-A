<% if account.errors.any? %>
  <div class="form-errors">
    <strong>Please fix the following:</strong>
    <ul><% account.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
  </div>
<% end %>

<%= form_with model: account, url: url, method: account.persisted? ? :patch : :post, local: true do |f| %>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label"><i class="lucide-tag"></i> Nickname</label>
      <%= f.text_field :nickname, class: "form-input", placeholder: "e.g. Chase Sapphire", required: true %>
    </div>
    <div class="form-group">
      <label class="form-label"><i class="lucide-hash"></i> Last 4 Digits</label>
      <%= f.text_field :last4, class: "form-input", placeholder: "4242", maxlength: 4, required: true %>
    </div>
    <div class="form-group">
      <label class="form-label"><i class="lucide-credit-card"></i> Account Type</label>
      <%= f.select :account_type, Account::ACCOUNT_TYPES.map { |t| [t.titleize, t] }, {}, class: "form-select" %>
    </div>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><i class="lucide-save"></i> Save</button>
    <a href="<%= web_settings_path %>" class="btn btn-secondary"><i class="lucide-x"></i> Cancel</a>
  </div>
<% end %>
