<% if profile.errors.any? %>
  <div class="form-errors">
    <strong>Please fix the following:</strong>
    <ul><% profile.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
  </div>
<% end %>

<%= form_with model: profile, url: url, method: profile.persisted? ? :patch : :post, local: true do |f| %>
  <div class="form-group">
    <label class="form-label"><i class="lucide-building"></i> Business Name</label>
    <%= f.text_field :business_name, class: "form-input", placeholder: "e.g. Jane's Consulting LLC", required: true %>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label"><i class="lucide-hash"></i> EIN (optional)</label>
      <%= f.text_field :ein, class: "form-input", placeholder: "XX-XXXXXXX" %>
    </div>
    <div class="form-group">
      <label class="form-label"><i class="lucide-tag"></i> Business Type</label>
      <%= f.select :business_type, [["Sole Proprietorship", "sole_proprietorship"], ["Single Member LLC", "single_member_llc"]], {}, class: "form-select" %>
    </div>
    <div class="form-group">
      <label class="form-label"><i class="lucide-calendar"></i> Tax Year</label>
      <%= f.number_field :tax_year, class: "form-input", min: 2020, max: 2099, required: true %>
    </div>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><i class="lucide-save"></i> Save</button>
    <a href="<%= web_settings_path %>" class="btn btn-secondary"><i class="lucide-x"></i> Cancel</a>
  </div>
<% end %>
