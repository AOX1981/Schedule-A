<div class="auth-card">
  <h1 class="auth-title"><i class="lucide-receipt"></i> Schedule A</h1>
  <p class="auth-subtitle">Log in to your tax deduction tracker</p>

  <%= form_with url: login_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <label class="form-label" for="email"><i class="lucide-mail"></i> Email</label>
      <%= f.email_field :email, class: "form-input", placeholder: "you@example.com", required: true, autofocus: true %>
    </div>

    <div class="form-group">
      <label class="form-label" for="password"><i class="lucide-lock"></i> Password</label>
      <%= f.password_field :password, class: "form-input", placeholder: "Your password", required: true %>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary" style="width:100%; justify-content: center;">
        <i class="lucide-log-in"></i> Log In
      </button>
    </div>
  <% end %>

  <p class="auth-footer">
    Don't have an account? <a href="<%= register_path %>">Sign up</a>
  </p>
</div>
