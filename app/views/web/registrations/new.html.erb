<div class="auth-card">
  <h1 class="auth-title"><i class="lucide-receipt"></i> Schedule A</h1>
  <p class="auth-subtitle">Create your account to start tracking deductions</p>

  <% if @user.errors.any? %>
    <div class="form-errors">
      <strong>Please fix the following:</strong>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: register_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <label class="form-label"><i class="lucide-user"></i> Full Name</label>
      <%= f.text_field :full_name, class: "form-input", placeholder: "Jane Doe", required: true, autofocus: true %>
    </div>

    <div class="form-group">
      <label class="form-label"><i class="lucide-mail"></i> Email</label>
      <%= f.email_field :email, class: "form-input", placeholder: "you@example.com", required: true %>
    </div>

    <div class="form-group">
      <label class="form-label"><i class="lucide-lock"></i> Password</label>
      <%= f.password_field :password, class: "form-input", placeholder: "At least 6 characters", required: true %>
    </div>

    <div class="form-group">
      <label class="form-label"><i class="lucide-lock"></i> Confirm Password</label>
      <%= f.password_field :password_confirmation, class: "form-input", placeholder: "Repeat your password", required: true %>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary" style="width:100%; justify-content: center;">
        <i class="lucide-user-plus"></i> Create Account
      </button>
    </div>
  <% end %>

  <p class="auth-footer">
    Already have an account? <a href="<%= login_path %>">Log in</a>
  </p>
</div>
