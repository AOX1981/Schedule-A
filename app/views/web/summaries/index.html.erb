<!-- Page Header -->
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-warm-900 flex items-center gap-2.5">
    <i class="lucide-bar-chart-3 text-warm-500 text-[26px]"></i> Summaries
  </h1>
  <div>
    <%= form_with url: web_summaries_path, method: :get, local: true, class: "flex items-center gap-2" do %>
      <label class="text-sm font-semibold text-gray-700"><i class="lucide-calendar text-sm"></i> Tax Year</label>
      <select name="tax_year" class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white text-gray-800 focus:outline-none focus:border-warm-400 focus:ring-2 focus:ring-warm-400/20" onchange="this.form.submit()">
        <% (Date.current.year).downto(2020).each do |y| %>
          <option value="<%= y %>" <%= 'selected' if y == @tax_year %>><%= y %></option>
        <% end %>
      </select>
    <% end %>
  </div>
</div>

<!-- Overview Stats -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-lg shadow-sm p-5 flex items-center gap-4">
    <div class="w-12 h-12 rounded-lg bg-warm-100 text-warm-600 flex items-center justify-center text-xl">
      <i class="lucide-file-text"></i>
    </div>
    <div>
      <div class="text-xs text-gray-500">Business Receipts</div>
      <div class="text-xl font-bold text-gray-800"><%= @total_receipts %></div>
    </div>
  </div>
  <div class="bg-white rounded-lg shadow-sm p-5 flex items-center gap-4">
    <div class="w-12 h-12 rounded-lg bg-green-100 text-green-700 flex items-center justify-center text-xl">
      <i class="lucide-check-circle"></i>
    </div>
    <div>
      <div class="text-xs text-gray-500">Confirmed</div>
      <div class="text-xl font-bold text-gray-800"><%= @confirmed_count %></div>
    </div>
  </div>
  <div class="bg-white rounded-lg shadow-sm p-5 flex items-center gap-4">
    <div class="w-12 h-12 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-xl">
      <i class="lucide-list"></i>
    </div>
    <div>
      <div class="text-xs text-gray-500">Expense Lines</div>
      <div class="text-xl font-bold text-gray-800"><%= @total_expense_lines %></div>
    </div>
  </div>
  <div class="bg-white rounded-lg shadow-sm p-5 flex items-center gap-4">
    <div class="w-12 h-12 rounded-lg bg-green-100 text-green-700 flex items-center justify-center text-xl">
      <i class="lucide-calculator"></i>
    </div>
    <div>
      <div class="text-xs text-gray-500">Total Deductions</div>
      <div class="text-xl font-bold text-gray-800"><%= format_currency(@total_deductions) %></div>
    </div>
  </div>
</div>

<% if @pending_count > 0 %>
  <div class="flex items-center gap-2.5 bg-warm-100 text-warm-800 text-sm font-medium px-4 py-3 rounded-lg mb-6">
    <i class="lucide-alert-circle"></i>
    You have <strong><%= @pending_count %></strong> unconfirmed business receipt<%= @pending_count == 1 ? "" : "s" %> for <%= @tax_year %>.
    Confirm receipts from the <a href="<%= web_receipts_path(status: "pending") %>" class="text-warm-700 underline font-semibold">Receipts page</a> to include them in your summaries.
  </div>
<% end %>

<!-- Schedule C Summary -->
<div class="bg-white rounded-lg shadow-sm p-6 mb-6">
  <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2 mb-4">
    <i class="lucide-file-text text-warm-500"></i> Schedule C Lines
  </h2>
  <% if @schedule_c[:items].any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Line #</th>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Category</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Deduction</th>
          </tr>
        </thead>
        <tbody>
          <% @schedule_c[:items].each do |item| %>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-3 py-2.5 border-b border-gray-200 font-semibold">Line <%= item[:line_number] %></td>
              <td class="px-3 py-2.5 border-b border-gray-200"><%= category_label(item[:category]) %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right"><%= format_currency(item[:total]) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="bg-warm-50">
            <td colspan="2" class="px-3 py-2.5 font-bold">Grand Total</td>
            <td class="px-3 py-2.5 text-right font-bold"><%= format_currency(@schedule_c[:grand_total]) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% else %>
    <div class="text-center py-8 text-gray-400">
      <i class="lucide-info text-3xl text-warm-300 block mb-2"></i>
      <p>No confirmed business expenses for <%= @tax_year %>.</p>
    </div>
  <% end %>
</div>

<!-- By Category -->
<div class="bg-white rounded-lg shadow-sm p-6 mb-6">
  <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2 mb-4">
    <i class="lucide-tag text-warm-500"></i> By Category
  </h2>
  <% if @by_category.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Category</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Items</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Total Cost</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Writeoff</th>
          </tr>
        </thead>
        <tbody>
          <% @by_category.sort_by { |s| -s.total_writeoff.to_f }.each do |s| %>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-3 py-2.5 border-b border-gray-200"><%= category_label(s.tax_category) %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right"><%= s.line_count %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right"><%= format_currency(s.total_cost) %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right font-semibold"><%= format_currency(s.total_writeoff) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-8 text-gray-400">
      <i class="lucide-info text-3xl text-warm-300 block mb-2"></i>
      <p>No categorized expenses yet.</p>
    </div>
  <% end %>
</div>

<!-- By Vendor -->
<div class="bg-white rounded-lg shadow-sm p-6 mb-6">
  <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2 mb-4">
    <i class="lucide-store text-warm-500"></i> By Vendor
  </h2>
  <% if @by_vendor.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Vendor</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Items</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Total Cost</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Writeoff</th>
          </tr>
        </thead>
        <tbody>
          <% @by_vendor.sort_by { |s| -s.total_writeoff.to_f }.each do |s| %>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-3 py-2.5 border-b border-gray-200"><%= s.store_name %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right"><%= s.line_count %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right"><%= format_currency(s.total_cost) %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right font-semibold"><%= format_currency(s.total_writeoff) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-8 text-gray-400">
      <i class="lucide-info text-3xl text-warm-300 block mb-2"></i>
      <p>No vendor data yet.</p>
    </div>
  <% end %>
</div>

<!-- By Month -->
<div class="bg-white rounded-lg shadow-sm p-6">
  <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2 mb-4">
    <i class="lucide-calendar-days text-warm-500"></i> By Month
  </h2>
  <% if @by_month.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Month</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Items</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Total Cost</th>
            <th class="text-right px-3 py-2.5 bg-warm-100 text-warm-800 font-semibold text-xs uppercase tracking-wide border-b-2 border-warm-200">Writeoff</th>
          </tr>
        </thead>
        <tbody>
          <% @by_month.each do |s| %>
            <tr class="hover:bg-warm-50 transition-colors">
              <td class="px-3 py-2.5 border-b border-gray-200"><%= s.month.strftime("%B %Y") %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right"><%= s.line_count %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right"><%= format_currency(s.total_cost) %></td>
              <td class="px-3 py-2.5 border-b border-gray-200 text-right font-semibold"><%= format_currency(s.total_writeoff) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-8 text-gray-400">
      <i class="lucide-info text-3xl text-warm-300 block mb-2"></i>
      <p>No monthly data yet.</p>
    </div>
  <% end %>
</div>
