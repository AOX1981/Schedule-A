<div class="page-header">
  <h1 class="page-title"><i class="lucide-bar-chart-3"></i> Summaries</h1>
  <div>
    <%= form_with url: web_summaries_path, method: :get, local: true, class: "filter-bar" do %>
      <label class="form-label" style="margin-right:0.5rem;"><i class="lucide-calendar"></i> Tax Year</label>
      <select name="tax_year" class="form-select" style="width:auto;display:inline-block;" onchange="this.form.submit()">
        <% (Date.current.year).downto(2020).each do |y| %>
          <option value="<%= y %>" <%= 'selected' if y == @tax_year %>><%= y %></option>
        <% end %>
      </select>
    <% end %>
  </div>
</div>

<!-- Schedule C Summary -->
<div class="card" style="margin-bottom:1.5rem;">
  <h2 class="card-title"><i class="lucide-file-text"></i> Schedule C Lines</h2>
  <% if @schedule_c[:items].any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Line #</th>
          <th>Category</th>
          <th style="text-align:right;">Deduction</th>
        </tr>
      </thead>
      <tbody>
        <% @schedule_c[:items].each do |item| %>
          <tr>
            <td><strong>Line <%= item[:line_number] %></strong></td>
            <td><%= category_label(item[:category]) %></td>
            <td style="text-align:right;"><%= format_currency(item[:total]) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2"><strong>Grand Total</strong></td>
          <td style="text-align:right;"><strong><%= format_currency(@schedule_c[:grand_total]) %></strong></td>
        </tr>
      </tfoot>
    </table>
  <% else %>
    <p class="empty-state"><i class="lucide-info"></i> No confirmed business expenses for <%= @tax_year %>.</p>
  <% end %>
</div>

<!-- By Category -->
<div class="card" style="margin-bottom:1.5rem;">
  <h2 class="card-title"><i class="lucide-tag"></i> By Category</h2>
  <% if @by_category.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Category</th>
          <th style="text-align:right;">Items</th>
          <th style="text-align:right;">Total Cost</th>
          <th style="text-align:right;">Writeoff</th>
        </tr>
      </thead>
      <tbody>
        <% @by_category.sort_by { |s| -s.total_writeoff.to_f }.each do |s| %>
          <tr>
            <td><%= category_label(s.tax_category) %></td>
            <td style="text-align:right;"><%= s.line_count %></td>
            <td style="text-align:right;"><%= format_currency(s.total_cost) %></td>
            <td style="text-align:right;"><strong><%= format_currency(s.total_writeoff) %></strong></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state"><i class="lucide-info"></i> No categorized expenses yet.</p>
  <% end %>
</div>

<!-- By Vendor -->
<div class="card" style="margin-bottom:1.5rem;">
  <h2 class="card-title"><i class="lucide-store"></i> By Vendor</h2>
  <% if @by_vendor.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Vendor</th>
          <th style="text-align:right;">Items</th>
          <th style="text-align:right;">Total Cost</th>
          <th style="text-align:right;">Writeoff</th>
        </tr>
      </thead>
      <tbody>
        <% @by_vendor.sort_by { |s| -s.total_writeoff.to_f }.each do |s| %>
          <tr>
            <td><%= s.store_name %></td>
            <td style="text-align:right;"><%= s.line_count %></td>
            <td style="text-align:right;"><%= format_currency(s.total_cost) %></td>
            <td style="text-align:right;"><strong><%= format_currency(s.total_writeoff) %></strong></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state"><i class="lucide-info"></i> No vendor data yet.</p>
  <% end %>
</div>

<!-- By Month -->
<div class="card">
  <h2 class="card-title"><i class="lucide-calendar-days"></i> By Month</h2>
  <% if @by_month.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Month</th>
          <th style="text-align:right;">Items</th>
          <th style="text-align:right;">Total Cost</th>
          <th style="text-align:right;">Writeoff</th>
        </tr>
      </thead>
      <tbody>
        <% @by_month.each do |s| %>
          <tr>
            <td><%= s.month.strftime("%B %Y") %></td>
            <td style="text-align:right;"><%= s.line_count %></td>
            <td style="text-align:right;"><%= format_currency(s.total_cost) %></td>
            <td style="text-align:right;"><strong><%= format_currency(s.total_writeoff) %></strong></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state"><i class="lucide-info"></i> No monthly data yet.</p>
  <% end %>
</div>
